# 复制为 .env（或用 docker compose 的 env_file）后按需修改
# 注意：以下变量是后端启动的必需项，缺失时对应能力会被拒绝而不是悄悄降级。

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shiyissh
DB_USERNAME=root
DB_PASSWORD=change-me

# Qdrant（缺省 localhost:6333；集群请填实际地址）
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# 接口鉴权：设置后所有 /api/** 请求必须带 X-Api-Key（或 Authorization: Bearer），
# 未设置时后端直接 401 拒绝（不再默认放行）。
APP_API_KEY=change-me

# 连接凭据加密密钥：用于加密 SSH 密码/私钥，必须设置且不要变更（变更后已存凭据无法解密）。
# 建议 32 字节以上的随机串。
APP_CRYPTO_KEY=change-me-32-bytes-random

# 模型与检索
DASHSCOPE_API_KEY=
APPBUILDER_API_KEY=
