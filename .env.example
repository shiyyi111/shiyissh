# 数据库（application-dev.yml 里用 ${DB_PASSWORD:} 占位）
DB_PASSWORD=
# Qdrant 向量库地址（内网/本机均可，默认 localhost:6333）
QDRANT_HOST=localhost
QDRANT_PORT=6333
# DashScope（阿里云百炼）API Key：对话 + embedding + rerank
DASHSCOPE_API_KEY=
# 百度 AppBuilder Key（仅 MCP 工具示例需要，可留空）
APPBUILDER_API_KEY=
# 接口鉴权（默认空 = 关闭，生产务必设置）
APP_SECURITY_API_KEY=
